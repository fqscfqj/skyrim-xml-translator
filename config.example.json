{
    "llm": {
        "api_key": "<YOUR_LLM_API_KEY>",
        "base_url": "https://api.example.com/v1",
        "model": "gpt-3.5-turbo",
        "max_retries": 3,
        "backoff_base": 0.5,
        "stream": false,
        "json_response_format_enabled": true,
        "request_timeout": 30,
        "request_timeout_step": 15,
        "request_timeout_max": 180,
        "retry_total_timeout": 300,
        "parameters": {
            "temperature": null,
            "top_p": null,
            "enable_thinking": null
        }
    },
    "llm_search": {
        "api_key": "<YOUR_SEARCH_LLM_API_KEY>",
        "base_url": "https://api.example.com/v1",
        "model": "gpt-3.5-turbo",
        "max_retries": 3,
        "backoff_base": 0.5,
        "stream": false,
        "json_response_format_enabled": true,
        "request_timeout": 30,
        "request_timeout_step": 15,
        "request_timeout_max": 180,
        "retry_total_timeout": 300,
        "parameters": {
            "temperature": null,
            "top_p": null,
            "enable_thinking": null
        }
    },
    "llm_search_fallback": {
        "api_key": "<YOUR_FALLBACK_SEARCH_LLM_API_KEY>",
        "base_url": "https://api.example.com/v1",
        "model": "gpt-3.5-turbo",
        "max_retries": 3,
        "backoff_base": 0.5,
        "stream": false,
        "json_response_format_enabled": true,
        "request_timeout": 30,
        "request_timeout_step": 15,
        "request_timeout_max": 180,
        "retry_total_timeout": 300,
        "parameters": {
            "temperature": null,
            "top_p": null,
            "enable_thinking": null
        }
    },
    "embedding": {
        "api_key": "<YOUR_EMBEDDING_API_KEY>",
        "base_url": "https://api.example.com/v1",
        "model": "text-embedding-3-large",
        "dimensions": 1536
    },
    "paths": {
        "glossary_file": "glossary/glossary.json",
        "vector_index_file": "glossary/vector_index.npy"
    },
    "threads": {
        "translation": 8,
        "vectorization": 8
    },
    "rag": {
        "similarity_threshold": 0.75,
        "short_term_max_results": 5,
        "long_term_max_results": 2,
        "short_term_max_chars": 32,
        "keyword_max_queries": 128,
        "keyword_task_decompose_enabled": true,
        "keyword_task_keep_original": false,
        "min_vector_score": 0.45,
        "keyword_weight_enabled": true,
        "keyword_weight_candidate_pool_size": 24,
        "keyword_weight_keep_k": 24,
        "keyword_weight_min_primary_hits": 8,
        "keyword_weight_exact_boost": 0.14,
        "keyword_weight_contains_boost": 0.06,
        "keyword_weight_token_boost": 0.04,
        "keyword_weight_anchor_max_df": 500,
        "keyword_weight_anchor_boost": 0.18,
        "glossary_context_max_chars": 4000,
        "format_extra_retries": 2,
        "latin_ratio_threshold": 2.0,
        "vector_index_checkpoint_terms": 1000,
        "glossary_import_max_rows": 0,
        "glossary_import_max_field_chars": 0
    },
    "general": {
        "log_level": "INFO",
        "prompt_style": "default",
        "style_profile": "auto",
        "language": "auto",
        "color_mode": "auto",
        "source_language": "auto",
        "target_language": "zh",
        "mcm_output_language_suffix": "source",
        "mcm_auto_export": true,
        "task_completion_sound_enabled": false,
        "log_file": "logs/app.log",
        "long_text_chunking_enabled": true,
        "long_text_chunk_threshold_chars": 4000,
        "long_text_chunk_target_chars": 1800,
        "prompt_cache_warmup_enabled": true,
        "short_text_batch_enabled": false,
        "short_text_batch_max_chars": 50,
        "short_text_batch_size": 8,
        "short_text_batch_circuit_min_items": 16,
        "short_text_batch_circuit_fallback_ratio": 0.5,
        "long_text_disable_thinking": true
    },
    "cache": {
        "translation_cache_size": 50000,
        "embedding_cache_size": 5000,
        "embedding_cache_memory_mb": 256,
        "cache_persist_dir": "cache",
        "cache_ttl_hours": 0
    }
}
