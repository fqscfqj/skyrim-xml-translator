        "keyword_max_queries": 8,
        "keyword_llm_max_tokens": 96,
        "ai_candidate_selection_enabled": true,
        "ai_candidate_pool_size": 12,
        "ai_candidate_max_select": 6,
        "ai_candidate_max_tokens": 96,
        "ai_candidate_context_chars": 320,
        "ai_candidate_min_vector_score": 0.45
    }
    ,
    "general": {
        "log_level": "INFO",
        "prompt_style": "default",
        "language": "auto",
        "source_language": "auto",
        "target_language": "zh",
        "mcm_output_language_suffix": "source",
        "mcm_auto_export": true
    }
